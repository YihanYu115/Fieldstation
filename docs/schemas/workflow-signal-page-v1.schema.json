{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-signal-page/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "signals", "next_cursor", "has_more", "truncated"],
  "properties": {
    "contract": {"const": "workflow-signal-page/v1"},
    "signals": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/signal"}},
    "next_cursor": {"type": "string", "maxLength": 512},
    "has_more": {"type": "boolean"},
    "truncated": {"type": "boolean"}
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "kind", "action", "relation", "candidate_issue_ids", "truncated"],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "kind": {"const": "evidence_relation_changed"},
        "action": {"enum": ["create", "reactivate"]},
        "relation": {
          "type": "object", "additionalProperties": false,
          "required": ["consumer_evidence_id", "provider_evidence_id", "relation_type", "active"],
          "properties": {
            "consumer_evidence_id": {"type": "string", "minLength": 1, "maxLength": 512},
            "provider_evidence_id": {"type": "string", "minLength": 1, "maxLength": 512},
            "relation_type": {"const": "challenges"},
            "active": {"const": true}
          }
        },
        "candidate_issue_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "truncated": {"const": false}
      }
    }
  }
}
