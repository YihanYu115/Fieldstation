        <mxCell id="external" value="&lt;b style=&quot;font-size:32px&quot;&gt;外部调用者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;编排、工具或程序&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b style=&quot;font-size:32px&quot;&gt;1  接收请求并检查权限&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;检查参数和身份 · 拒绝越权 · 识别重复请求&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="1040" height="110" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="&lt;b style=&quot;font-size:32px&quot;&gt;2  执行保存或修改&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;保存问题、证据、关系和结论&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;检查版本并记录修改历史&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="maintain" value="&lt;b style=&quot;font-size:32px&quot;&gt;6  检查结论是否需更新&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;对照当时与现在的依据&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;记录原因及影响范围&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="&lt;b style=&quot;font-size:32px&quot;&gt;4  取证据并核对版本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;读取相关证据及其关系&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;整理成规则计算的输入&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="550" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="compute" value="&lt;b style=&quot;font-size:32px&quot;&gt;5  计算证据能否使用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;根据必要依赖与有效反驳&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;返回可用、不可用或未决&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="550" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;b style=&quot;font-size:32px&quot;&gt;3  保存数据与历史&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;保存证据、关系、结论与当时依据；记录变化；修改与检查结果一起保存&lt;/span&gt;" style="shape=cylinder3;size=13;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172033;spacing=12;" vertex="1" parent="1">
