        <mxCell id="manager" value="&lt;b style=&quot;font-size:32px&quot;&gt;经理：安排工作&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;把研究建议变成局部任务&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;判断下一步、等待或结束&lt;/span&gt;" style="fontFamily=Microsoft YaHei;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="experimenter" value="&lt;b style=&quot;font-size:32px&quot;&gt;实验员：执行任务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;开展计算或实验&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;交付结果、来源与验收判断&lt;/span&gt;" style="fontFamily=Microsoft YaHei;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="curator" value="&lt;b style=&quot;font-size:32px&quot;&gt;整理员：整理入账&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;整理材料，登记贡献&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;补充关系与整理意见&lt;/span&gt;" style="fontFamily=Microsoft YaHei;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1170" y="180" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="scientist" value="&lt;b style=&quot;font-size:32px&quot;&gt;科学家：作出判断&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;提出可检验的问题&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;给出解释、方向和限制&lt;/span&gt;" style="fontFamily=Microsoft YaHei;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="conclusion" value="&lt;b style=&quot;font-size:32px&quot;&gt;结论员：形成结论&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;核对判断与采用依据&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;保存结论，或提出具体缺口&lt;/span&gt;" style="fontFamily=Microsoft YaHei;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="560" width="410" height="150" as="geometry" />
        </mxCell>
        <mxCell id="im" value="&lt;b style=&quot;font-size:32px&quot;&gt;IM：保存材料、证据关系与结论，维护历史和依据变化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#475569&quot;&gt;各岗按权限读写 IM；编排程序负责触发、交接、准确等待与恢复。&lt;/span&gt;" style="fontFamily=Microsoft YaHei;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2.5;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
